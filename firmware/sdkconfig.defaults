# Classic Ai-Thinker ESP32-CAM; verify selected module/PSRAM variant in menuconfig.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SCCB_HARDWARE_I2C_PORT0=y
CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW=y
# GPIO1/3 are IMU I2C at runtime, so they cannot carry UART logging/console.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
